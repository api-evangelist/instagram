            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.facebook.com/v21.0/:user_id/media",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The Instagram user ID."
              },
              {
                "name": "fields",
                "value": "id,caption,media_type,media_url,timestamp,permalink",
                "type": "query",
                "description": "Comma-separated list of fields."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Maximum number of results per page."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination."
              },
              {
                "name": "access_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a collection of IG Media objects published on the account."
        },
        {
